# Referência dos nomes de variável esperados por cada worker.
# Não é pra copiar/preencher este arquivo: os workers leem via os.environ puro
# (sem python-dotenv), nenhum script carrega .env. Defina como variável de
# ambiente do sistema (Windows: escopo User) em vez de gravar em arquivo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
