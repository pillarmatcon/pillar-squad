# Referência dos nomes de variável esperados pelo worker.
# Não é pra copiar/preencher este arquivo: o worker lê via os.environ puro
# (sem python-dotenv), nenhum script carrega .env. Defina como variável de
# ambiente do sistema (Windows: escopo User) em vez de gravar em arquivo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
